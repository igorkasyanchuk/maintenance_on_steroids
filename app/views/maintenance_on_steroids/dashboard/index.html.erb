<div class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p class="subtitle">Maintenance tasks overview</p>
  </div>
</div>

<%# Stats Cards %>
<div class="stats-grid" id="dashboard-stats">
  <div class="stat-card">
    <div class="stat-number"><%= @stats[:total_tasks] %></div>
    <div class="stat-label">Available Tasks</div>
  </div>
  <div class="stat-card stat-card-active">
    <div class="stat-number"><%= @stats[:active_runs] %></div>
    <div class="stat-label">Active Runs</div>
  </div>
  <div class="stat-card stat-card-completed">
    <div class="stat-number"><%= @stats[:completed] %></div>
    <div class="stat-label">Completed</div>
  </div>
  <div class="stat-card stat-card-errored">
    <div class="stat-number"><%= @stats[:errored] %></div>
    <div class="stat-label">Errored</div>
  </div>
</div>

<%# Currently Active Runs %>
<div class="dashboard-section">
  <h2>Active Runs</h2>
  <div class="card" style="padding: 0; overflow: hidden;" id="active-runs-section">
    <% if @active_runs.any? %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Task</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Duration</th>
            <th>User</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @active_runs.each do |run| %>
            <tr>
              <td><a href="<%= run_path(run) %>">#<%= run.id %></a></td>
              <td>
                <% if run.task_exists? %>
                  <a href="<%= job_path(id: run.task_class) %>" class="cell-truncate" title="<%= run.task_title %>"><%= run.task_title %></a>
                <% else %>
                  <span class="cell-truncate" style="color: var(--text-muted);" title="<%= run.task_class %> (task class no longer exists)"><%= run.task_class %></span>
                <% end %>
              </td>
              <td>
                <span class="badge badge-<%= run.status %>"><%= run.status %></span>
                <% if (artifact_count = @artifact_counts.fetch(run.id, 0)) > 0 %>
                  <span class="badge" title="<%= pluralize(artifact_count, "artifact") %>">&#128206; <%= artifact_count %></span>
                <% end %>
              </td>
              <td>
                <% if run.progress_total > 0 %>
                  <div class="progress-container" style="height: 10px; width: 100px; display: inline-block; vertical-align: middle;">
                    <div class="progress-bar" style="width: <%= run.progress_percentage %>%; height: 100%;"></div>
                  </div>
                  <span style="font-size: 12px; color: var(--text-muted); margin-left: 6px;"><%= run.progress_percentage %>%</span>
                <% else %>
                  <span style="color: var(--text-muted);">&mdash;</span>
                <% end %>
              </td>
              <td><%= run.formatted_duration %></td>
              <td>
                <% if run.user_id.present? %>
                  <span class="cell-truncate-sm" title="<%= run.user_display %>"><%= run.user_display %></span>
                <% else %>
                  &mdash;
                <% end %>
              </td>
              <td><a href="<%= run_path(run) %>" class="btn btn-outline btn-sm">View</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state" style="padding: 32px;">
        <p>No active runs</p>
      </div>
    <% end %>
  </div>
</div>

<%# Recent History %>
<div class="dashboard-section">
  <h2>Recent History</h2>
  <div class="card" style="padding: 0; overflow: hidden;">
    <% if @recent_runs.any? %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Task</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Duration</th>
            <th>User</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @recent_runs.each do |run| %>
            <tr>
              <td><a href="<%= run_path(run) %>">#<%= run.id %></a></td>
              <td>
                <% if run.task_exists? %>
                  <a href="<%= job_path(id: run.task_class) %>" class="cell-truncate" title="<%= run.task_title %>"><%= run.task_title %></a>
                <% else %>
                  <span class="cell-truncate" style="color: var(--text-muted);" title="<%= run.task_class %> (task class no longer exists)"><%= run.task_class %></span>
                <% end %>
              </td>
              <td>
                <span class="badge badge-<%= run.status %>"><%= run.status %></span>
                <% if (artifact_count = @artifact_counts.fetch(run.id, 0)) > 0 %>
                  <span class="badge" title="<%= pluralize(artifact_count, "artifact") %>">&#128206; <%= artifact_count %></span>
                <% end %>
              </td>
              <td>
                <% if run.progress_total > 0 %>
                  <%= run.progress_current %> / <%= run.progress_total %>
                <% else %>
                  <span style="color: var(--text-muted);">&mdash;</span>
                <% end %>
              </td>
              <td><%= run.formatted_duration %></td>
              <td>
                <% if run.user_id.present? %>
                  <span class="cell-truncate-sm" title="<%= run.user_display %>"><%= run.user_display %></span>
                <% else %>
                  &mdash;
                <% end %>
              </td>
              <td style="white-space: nowrap;"><%= run.created_at.strftime("%b %d, %Y %H:%M") %></td>
              <td><a href="<%= run_path(run) %>" class="btn btn-outline btn-sm">View</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state" style="padding: 32px;">
        <p>No runs yet</p>
      </div>
    <% end %>
  </div>
</div>

<script>
(function() {
  var REFRESH_INTERVAL = 4000;
  var MAX_CONSECUTIVE_FAILURES = 5;
  var consecutiveFailures = 0;
  var timer = null;
  var inFlight = null;

  function teardown() {
    if (timer !== null) { clearInterval(timer); timer = null; }
    if (inFlight !== null) { inFlight.abort(); inFlight = null; }
    document.removeEventListener("turbo:before-visit", teardown);
    document.removeEventListener("turbo:before-cache", teardown);
    window.removeEventListener("pagehide", teardown);
  }

  document.addEventListener("turbo:before-visit", teardown);
  document.addEventListener("turbo:before-cache", teardown);
  window.addEventListener("pagehide", teardown);

  function refresh() {
    if (document.hidden) { return; }
    // Abort any still-in-flight refresh before starting a new one so slow
    // responses can't pile up or land out of order.
    if (inFlight !== null) { inFlight.abort(); }
    var controller = new AbortController();
    inFlight = controller;
    fetch(window.location.href, { headers: { "Accept": "text/html" }, signal: controller.signal })
      .then(function(res) {
        if (!res.ok) { throw new Error("HTTP " + res.status); }
        return res.text();
      })
      .then(function(html) {
        inFlight = null;
        consecutiveFailures = 0;
        var doc = new DOMParser().parseFromString(html, "text/html");
        ["dashboard-stats", "active-runs-section"].forEach(function(id) {
          var fresh = doc.getElementById(id);
          var current = document.getElementById(id);
          // Skip the swap if the user is interacting with something inside the
          // target (e.g. a focused View/pause link) so it isn't ripped out.
          // (teardown aborts the in-flight fetch, so this .then never runs
          // after teardown -- no detached-node guard needed.)
          if (current && fresh && !current.contains(document.activeElement)) {
            current.innerHTML = fresh.innerHTML;
          }
        });
      })
      .catch(function(err) {
        inFlight = null;
        if (err && err.name === "AbortError") { return; }
        consecutiveFailures += 1;
        if (consecutiveFailures >= MAX_CONSECUTIVE_FAILURES) { teardown(); }
      });
  }

  timer = setInterval(refresh, REFRESH_INTERVAL);
})();
</script>
