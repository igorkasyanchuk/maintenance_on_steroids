<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dummy App</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f9fafb;
      color: #1f2937;
      line-height: 1.6;
    }

    nav {
      background: #1f2937;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    nav a { color: white; text-decoration: none; font-size: 14px; }
    nav .brand { font-weight: 700; font-size: 18px; }
    nav .links { display: flex; gap: 20px; align-items: center; }
    nav .links a { opacity: 0.8; }
    nav .links a:hover { opacity: 1; }
    nav .user-info { color: #9ca3af; font-size: 13px; }

    .container { max-width: 800px; margin: 0 auto; padding: 40px 24px; }

    .flash {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .flash-notice { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .flash-alert  { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="brand">Dummy App</a>
    <div class="links">
      <% if user_signed_in? %>
        <span class="user-info"><%= current_user.email %> (<%= current_user.role %>)</span>
        <a href="/maintenance">Maintenance Tasks</a>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, style: "background: none; border: none; color: white; cursor: pointer; font-size: 14px; opacity: 0.8; padding: 0; font-family: inherit;" %>
      <% else %>
        <a href="<%= new_user_session_path %>">Sign in</a>
        <a href="<%= new_user_registration_path %>">Sign up</a>
      <% end %>
    </div>
  </nav>

  <div class="container">
    <% if notice %>
      <div class="flash flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash flash-alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </div>

  <%= any_login_here if defined?(AnyLogin) && AnyLogin.enabled %>
</body>
</html>
